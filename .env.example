# Web server (3000 often busy — default in code is 3080)
PORT=3080

# Session-Login: mind. 16 Zeichen (empfohlen: 32+ zufällige Zeichen). Fehlt der Wert, generiert der Server ein temporäres Secret (Warnung im Log).
SESSION_SECRET=
# NUR Kurz-Diagnose: GET /api/leads ohne Login (alle Daten öffentlich). Sofort löschen nach Test.
# PVL_DEBUG_PUBLIC_LEADS_GET=
# Hinter HTTPS / Nginx: SESSION_COOKIE_SECURE=1 setzen
SESSION_COOKIE_SECURE=
# Basis-URL für Links in E-Mails (Zugangsdaten) — auch für CORS (Origin muss erlaubt sein)
APP_BASE_URL=https://pvl.lifeco.at
# Optional: weitere erlaubte Browser-Origins (kommagetrennt), z. B. https://www.pvl.lifeco.at
# CORS_ORIGINS=
# Einmalig ersten Admin per UI: gleicher Wert in login.html „Setup-Token“
SETUP_TOKEN=
# Optional: Passwort-Vergessen auf login.html (mind. 16 Zeichen); gleicher Wert im Formular „Reset-Token“
PASSWORD_RESET_TOKEN=

# --- Leads (SQLite) ---
# Optional: absoluter Pfad zur SQLite-Datei (Default: <Projekt>/data/leads.db).
# Auf dem Server nach Umzug nach /root/pv-lead-manager empfohlen:
# SQLITE_LEADS_DB=/root/pv-lead-manager/data/leads.db
# Datenrettung von /opt (WAL beachten — sonst 0 Leads trotz Kopie):
#   ./scripts/restore-leads-db-from-legacy.sh /opt/pv-lead-manager/data /root/pv-lead-manager/data
# Diagnose (Admin-Session oder Bearer ADMIN_TOKEN):
#   curl -sS -H "Authorization: Bearer $ADMIN_TOKEN" http://127.0.0.1:3080/api/debug/leads-db
SQLITE_LEADS_DB=

# --- n8n Webhook (POST /api/webhook/n8n-lead, Header x-n8n-api-key) ---
N8N_API_KEY=
# Dashboard „Leads synchronisieren“: POST an diese n8n-URL (Workflow bis Response = fertig; ggf. gleicher Header wie oben)
N8N_WEBHOOK_URL=

# --- n8n Import-Trigger (Admin-Button im Dashboard → POST /api/sync-leads) ---
# Auf 0/false/off: kein E-Mail-/n8n-Import (weder Sync-Button/Webhook-Trigger noch POST /api/webhook/n8n-lead). Nur manueller CSV-Import „Leads hochladen“.
# EMAIL_LEAD_IMPORT_ENABLED=0
# Vollständige Production-Webhook-URL (POST), z. B. https://n8n.lifeco.at/webhook/import-leads
N8N_IMPORT_LEADS_WEBHOOK_URL=
# Optional: erlaubte Hostnamen (CSV). Default: n8n.lifeco.at
# N8N_IMPORT_WEBHOOK_ALLOWED_HOSTS=n8n.lifeco.at

# --- Lead extraction (NOORTEC: Default DeepSeek, OpenAI-kompatibel) ---
# openai-compatible | deepseek | openai | anthropic
LLM_PROVIDER=openai-compatible
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# Fallback wenn kein DEEPSEEK_API_KEY
# OPENAI_API_KEY=
LLM_MODEL=deepseek-chat
# 0 = kein response_format json_object (z. B. anderer OpenAI-kompatibler Provider)
# LLM_JSON_OBJECT=1

# Nur bei LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

MY_NAME=
MY_EMAIL=
MY_PHONE=
EMAIL_SIGNATURE=

# --- E-Mail-Versand (Zugangsdaten, Kundenbestätigung nach neuem Lead) ---
# NOORTEC Standard:
# SMTP_HOST=noortec.at
# SMTP_PORT=587
# SMTP_SECURE=tls
SMTP_HOST=noortec.at
SMTP_PORT=587
# Werte: tls/starttls (Port 587), ssl/1/true (Port 465), leer=Auto
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# Absender (falls leer: SMTP_USER)
MAIL_FROM=
# Persönlicher Versand (/profile): gleicher SMTP-Server für alle; Login-Name = Kontakt-E-Mail des Nutzers.
# Wenn leer, gelten SMTP_HOST / SMTP_PORT.
DEFAULT_SMTP_HOST=noortec.at
DEFAULT_SMTP_PORT=587

# --- REONIC (optional: nach Status „Termin vereinbart“ + Bestätigung → REST v2 Offers) ---
# API-Key für Header x-authorization: entweder vollständig wie in Reonic (z. B. „Basic <Base64>“) oder nur die Base64-Kette (wird automatisch mit „Basic “ ergänzt). Keine Anführungszeichen/Spaces am Ende.
# Alias: REONIC_V2_KEY (falls REONIC_API_KEY nicht gesetzt)
REONIC_API_KEY=
# REST v2 Basis (Standard: api.reonic.de)
REONIC_REST_API_BASE=https://api.reonic.de
# Client-ID (UUID aus Reonic)
REONIC_REST_CLIENT_ID=6a8ea480-3152-49f9-aa1a-2c87d21774a0
# Jahresverbrauch kWh/a falls nicht aus Info/Notizen parsebar
# REONIC_DEFAULT_ANNUAL_KWH=4500
# Strompreis ct/kWh (Voreinstellung Angebot)
# REONIC_DEFAULT_ENERGY_PRICE_CT=35
#
# Legacy H360 Create Request (app.reonic.de) — nur falls weiterhin genutzt:
# REONIC_API_BASE_URL=https://app.reonic.de
# REONIC_CLIENT_ID=
# REONIC_API_URL=

# Admin API: Bearer für POST /api/admin/users ohne Session
ADMIN_TOKEN=
